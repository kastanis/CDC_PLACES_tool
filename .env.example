FEEDBACK_BACKEND=local

# Use these when FEEDBACK_BACKEND=supabase.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-server-side-supabase-key
SUPABASE_FEEDBACK_TABLE=question_feedback

# Optional metadata stored with each feedback row.
DATASET_ID=cdc_places_county_gis_2025
APP_VERSION=local-dev

# Optional local/free LLM parser. Requires Ollama running locally.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60

# Optional hosted LLM parsers. These cost API credits.
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
